# Copy this file to .env for local development and fill in a real value.
# .env itself is gitignored -- never commit real secrets.

# A random string mixed into every password hash. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=replace-with-a-long-random-string

# Optional. Defaults to 3000.
PORT=3000
